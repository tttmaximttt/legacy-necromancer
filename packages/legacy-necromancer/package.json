{
  "name": "legacy-necromancer",
  "version": "0.1.0",
  "description": "Revive abandoned Node.js projects: map the code, date the dependencies, rebuild it in a Docker sandbox on its era's Node, and snapshot its behaviour.",
  "keywords": ["legacy-code", "nodejs", "docker", "mcp", "claude", "code-archaeology", "dependencies"],
  "license": "MIT",
  "author": "Maksym Radko",
  "homepage": "https://github.com/tttmaximttt/legacy-necromancer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tttmaximttt/legacy-necromancer.git",
    "directory": "packages/legacy-necromancer"
  },
  "bugs": "https://github.com/tttmaximttt/legacy-necromancer/issues",
  "type": "module",
  "bin": {
    "necromancer": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "node build.mjs",
    "smoke": "node smoke.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.0.0",
    "dockerode": "^5.0.1",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-metrics": "^2.4.2",
    "semver": "^7.8.5",
    "simple-git": "^4.0.2",
    "web-tree-sitter": "^0.27.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2"
  }
}
